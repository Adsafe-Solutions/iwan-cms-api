# Copy to .env and fill in. Never commit the filled copy.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
#
# ⚠ There is ONE database — `iwan_cms` — and it is the live one. The deployed
# API and your machine both connect to it, so `npm run seed:reset` deletes real
# content with nothing to fall back on. Take a mongodump first.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/iwan_cms_dev?retryWrites=true&w=majority

# Signing key for admin session tokens. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ⚠ Changing it invalidates every issued token, which logs all editors out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API — the public
# site and the CMS admin, per environment. A request from anywhere else is
# refused by CORS. Server-to-server callers send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The first admin account, created by `npm run create:admin`.
# Also used by `npm run dev:memory` for its throwaway login, so setting them here
# means the same credentials work whichever database you are on.
#
# ⚠ Only ever in .env, never in a committed file. `dev-memory.js` falls back to
# obvious rubbish precisely so a real password is never written into the repo.
ADMIN_EMAIL=admin@iwan.community
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Iwan Admin

# --- Transactional mail (Resend) ---
# The confirmation sent after someone registers for an event — see lib/mail.js.
#
# ⚠ UNSET IS THE SWITCHED-OFF STATE. With no key nothing is sent and sign-ups
# carry on as before, so a deployment without one still works. What IS refused
# at boot is half-configuration: a key with no MAIL_FROM would fail every send
# at the moment someone has just been told their place is booked.
RESEND_API_KEY=
# Resend requires this domain to be verified in its dashboard. Before that,
# only `onboarding@resend.dev` sends, and only to the Resend account owner.
MAIL_FROM=Iwan Community <no-reply@iwan.community>
# Optional. Where a reply to the confirmation goes.
MAIL_REPLY_TO=
# Optional. Used to build the event link inside the confirmation; omitted when
# this is empty.
SITE_URL=https://iwan.community

# ⚠ THE OPPOSITE DIRECTION TO MAIL_FROM — where IWAN is told about a form,
# not where a confirmation is sent. Every public form (registration, contact,
# subscribe, volunteer, career) sends a heads-up here. Comma-separated for
# more than one address. Unset means no notifications at all; every form
# still works and still stores what was submitted — this only controls
# whether anyone is told about it by email.
MAIL_TO=
# Optional. Deep-links each notification at the right CMS screen (its
# "See it in the CMS" button). Omitted, the notification just has no button.
CMS_URL=https://cms.iwan.community

# THIS API's own public address — what a third party reaches it on. A process
# behind a proxy sees a port, not the hostname the world uses, so it cannot work
# this out for itself.
#
# It builds the unsubscribe link in the confirmation email, and the matching
# List-Unsubscribe headers. ⚠ UNSET MEANS BOTH ARE DROPPED — a link to localhost
# in somebody's inbox is worse than no link at all. Not a secret.
API_URL=https://iwan-cms-api.vercel.app

# Shared with the public site's Cloudflare Worker. The Worker verifies Turnstile
# and forwards the submission with this value in an X-Forward-Secret header; the
# API refuses public form posts that do not carry it.
#
# ⚠ WITHOUT IT TURNSTILE IS DECORATIVE — this API has its own hostname, so a bot
# that finds it posts straight here and skips the check entirely. Set the SAME
# value here and in the Worker (`wrangler secret put CMS_FORWARD_SECRET`).
#
# ⚠ Unset means the check is OFF and every form still works, so a deployment
# that has not been given it yet is not a site with broken forms.
CMS_FORWARD_SECRET=

# --- The Resend audience (contact sync) ---
# EVERYONE who fills in a public form is mirrored into Resend as a contact —
# subscribed or not. The ones who never ticked the newsletter box go across as
# `unsubscribed: true`, which every broadcast skips; it is a suppression
# record, not a mailing-list entry. Iwan's `audience` collection stays the
# record of truth regardless of what Resend does with the mirror.
#
# ⚠ It rides on RESEND_API_KEY above — no key, no sync, and every form still
# works exactly as before. Nothing else needs setting for this to happen: three
# segments ("Iwan India", "Iwan Canada", "Event registrations") are created
# automatically on first use — see lib/segments.js. There is nothing to set up
# in the Resend dashboard for those three.
#
# Optional, and ONE EXTRA id on top of the three automatic ones — not a
# replacement for them. Whatever this points at, every mirrored contact also
# joins it, which is only worth setting if you already have a segment you
# broadcast to by hand. ⚠ IT COUNTS AGAINST THE PLAN'S SEGMENT CAP like any
# other — leave it unset unless you are actually using it, since Resend plans
# cap how many segments an account may hold and the automatic three already
# spend part of that budget.
RESEND_SEGMENT_ID=
#
# The SIGNING SECRET for Resend's calls back to us — a different credential from
# the API key. Create a webhook in the Resend dashboard pointing at
#   https://YOUR-API-HOST/api/webhooks/resend
# subscribed to contact.created, contact.updated, contact.deleted and
# email.complained, then copy the `whsec_…` secret from its details page.
#
# ⚠ This is what carries an UNSUBSCRIBE back. Someone clicking the link at the
# bottom of a broadcast is recorded by Resend, not by this API, and without the
# webhook Iwan goes on believing they are subscribed. Unset means the endpoint
# answers 503 and Resend retries, so nothing is lost while it is being set up.
RESEND_WEBHOOK_SECRET=

# Optional. Overrides which Resend Template alias each message looks for —
# only worth setting if an account already has its own naming. The defaults
# (iwan-registration, iwan-subscribe-welcome, iwan-application, iwan-contact,
# each with -in / -ca country variants tried first) are in lib/templates.js
# and need nothing set here to work. See the README's "Editing the emails in
# Resend" section for the full alias list and what each template must declare.
RESEND_TEMPLATE_REGISTRATION=
RESEND_TEMPLATE_WELCOME=
RESEND_TEMPLATE_APPLICATION=
RESEND_TEMPLATE_CONTACT=

# --- Rate limits ---
# How many SUCCESSFUL submissions one address may make per ten minutes.
# ⚠ FORM_* is shared across subscribe, contact, volunteer and career — the
# limit is on the person, not the form. REGISTER_* is event registration's own,
# tighter pair, kept separate because it is the one write more likely to be
# hammered by a bot testing an event's capacity.
#
# ⚠ Only counts successes (`skipFailedRequests`) — someone mistyping their
# email three times is not what this is for. A second, looser limit
# (FORM_ATTEMPT_LIMIT / REGISTER_ATTEMPT_LIMIT) catches probing instead.
# Defaults shown are what the code falls back to if these are left unset —
# only set them to override.
FORM_WRITE_LIMIT=8
FORM_ATTEMPT_LIMIT=40
REGISTER_WRITE_LIMIT=5
REGISTER_ATTEMPT_LIMIT=40

# --- Cloudflare R2 (image uploads) ---
# Where an image pasted or dropped into the CMS is actually stored.
#
# ⚠ ALL FIVE OR NONE — assertConfig refuses to boot on a half-set block, the
# same rule as mail above. With none of them set, uploading is switched off
# and the CMS falls back to pasting a URL directly, which is how it worked
# before this existed — nothing breaks, editors just lose the Upload button.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ⚠ THE CUSTOM DOMAIN IN FRONT OF THE BUCKET, not the raw S3 endpoint — this is
# what gets stored on the record and served to visitors, so it has to be the
# public-facing hostname, not R2's own API host.
R2_PUBLIC_URL=https://cdn.iwan.community
