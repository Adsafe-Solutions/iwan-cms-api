# Copy to .env and fill in. Never commit the filled copy.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
#
# ⚠ There is ONE database — `iwan_cms` — and it is the live one. The deployed
# API and your machine both connect to it, so `npm run seed:reset` deletes real
# content with nothing to fall back on. Take a mongodump first.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/iwan_cms_dev?retryWrites=true&w=majority

# Signing key for admin session tokens. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ⚠ Changing it invalidates every issued token, which logs all editors out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API — the public
# site and the CMS admin, per environment. A request from anywhere else is
# refused by CORS. Server-to-server callers send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The first admin account, created by `npm run create:admin`.
# Also used by `npm run dev:memory` for its throwaway login, so setting them here
# means the same credentials work whichever database you are on.
#
# ⚠ Only ever in .env, never in a committed file. `dev-memory.js` falls back to
# obvious rubbish precisely so a real password is never written into the repo.
ADMIN_EMAIL=admin@iwan.community
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Iwan Admin

# --- Transactional mail (Resend) ---
# The confirmation sent after someone registers for an event — see lib/mail.js.
#
# ⚠ UNSET IS THE SWITCHED-OFF STATE. With no key nothing is sent and sign-ups
# carry on as before, so a deployment without one still works. What IS refused
# at boot is half-configuration: a key with no MAIL_FROM would fail every send
# at the moment someone has just been told their place is booked.
RESEND_API_KEY=
# Resend requires this domain to be verified in its dashboard. Before that,
# only `onboarding@resend.dev` sends, and only to the Resend account owner.
MAIL_FROM=Iwan Community <no-reply@iwan.community>
# Optional. Where a reply to the confirmation goes.
MAIL_REPLY_TO=
# Optional. Used to build the event link inside the confirmation; omitted when
# this is empty.
SITE_URL=https://iwan.community

# THIS API's own public address — what a third party reaches it on. A process
# behind a proxy sees a port, not the hostname the world uses, so it cannot work
# this out for itself.
#
# It builds the unsubscribe link in the confirmation email, and the matching
# List-Unsubscribe headers. ⚠ UNSET MEANS BOTH ARE DROPPED — a link to localhost
# in somebody's inbox is worse than no link at all. Not a secret.
API_URL=https://iwan-cms-api.vercel.app

# --- The Resend audience (contact sync) ---
# Everyone who SUBSCRIBES is mirrored into Resend as a contact, so a newsletter
# can be written in Resend's own composer instead of exporting a CSV. Iwan's
# `audience` collection stays the record of truth; Resend gets the subset that
# agreed to be mailed.
#
# ⚠ It rides on RESEND_API_KEY above — no key, no sync, and every form still
# works exactly as before. Nothing else needs setting for the push to happen.
#
# Optional, and ONE id — not one per form. A Resend segment is a static list, so
# this is simply the list every mirrored subscriber joins; the `source` property
# on each contact is what tells them apart inside it. Copy the id from the
# segment's page in the dashboard. With none set they are still contacts on the
# account, just ungrouped.
#
# ⚠ The contact PROPERTIES (source, country, joined, managed_by) need nothing
# here and nothing in the dashboard — the API creates them on the first sync.
RESEND_SEGMENT_ID=
#
# The SIGNING SECRET for Resend's calls back to us — a different credential from
# the API key. Create a webhook in the Resend dashboard pointing at
#   https://YOUR-API-HOST/api/webhooks/resend
# subscribed to contact.created, contact.updated, contact.deleted and
# email.complained, then copy the `whsec_…` secret from its details page.
#
# ⚠ This is what carries an UNSUBSCRIBE back. Someone clicking the link at the
# bottom of a broadcast is recorded by Resend, not by this API, and without the
# webhook Iwan goes on believing they are subscribed. Unset means the endpoint
# answers 503 and Resend retries, so nothing is lost while it is being set up.
RESEND_WEBHOOK_SECRET=
