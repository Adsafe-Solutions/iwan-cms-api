{
  "name": "iwan-cms-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CMS API for iwan.community \u2014 events, blogs, podcasts and promos, per country",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "create:admin": "node scripts/create-admin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.js",
    "webhook:ping": "node scripts/webhook-ping.js",
    "dev:memory": "node scripts/dev-memory.js",
    "migrate:blog-html": "node scripts/migrate-blog-html.js",
    "sync:contacts": "node scripts/sync-contacts.js",
    "vendor:sanitizer": "node scripts/vendor-sanitizer.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "resend": "^6.22.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "3.9.6"
  }
}
