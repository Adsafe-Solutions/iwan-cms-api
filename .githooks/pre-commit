#!/usr/bin/env sh
set -eu

# Refuses a commit that would put a PLAINTEXT secrets file into git history.
# `.env` is committed to this repo, deliberately, sops-encrypted — see the
# environment-and-secrets skill (.agents/skills/environment-and-secrets/) for
# why that is a real, intentional convention here and not a mistake to "fix"
# by re-adding it to .gitignore. This hook is what makes that convention safe
# to rely on: without it, a `sops -d .env` run to read a value locally, left
# un-re-encrypted, would ship a real secret into git history the moment it is
# committed — and unlike a leaked file caught before pushing, history is hard
# to fully undo once it exists.
#
# Ported from new-iwan's .githooks/pre-commit, which has protected the same
# convention there — this repo had no equivalent until now, despite carrying
# the identical risk.

for file in .env secrets.yaml; do
  if git diff --cached --name-only --diff-filter=ACMR -- "$file" | grep -q .; then
    if ! command -v sops >/dev/null 2>&1; then
      echo "pre-commit: sops is required to validate $file" >&2
      exit 1
    fi

    if ! sops filestatus "$file" 2>/dev/null | grep -q '"encrypted":true'; then
      echo "pre-commit: refusing to commit plaintext $file; encrypt it with SOPS first" >&2
      echo "  sops --encrypt --in-place $file" >&2
      exit 1
    fi
  fi
done

staged_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(css|html|js|jsx|json|md|mjs|toml|ya?ml)$' || true)
if [ -n "$staged_files" ]; then
  # Repository paths contain no spaces; keep the hook dependency-free.
  npx --no-install prettier --check --ignore-unknown $staged_files
fi
